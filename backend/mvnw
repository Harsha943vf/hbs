# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.2.0
# ----------------------------------------------------------------------------

# If JAVA_HOME is set, use it; otherwise try to find java in PATH
if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

# Determine the script's directory
SCRIPT_DIR=$(dirname "$0")
MAVEN_PROJECTBASEDIR=$(cd "$SCRIPT_DIR" && pwd)

MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Read distributionUrl from properties
DISTRIBUTION_URL=$(grep "^distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2 | tr -d '\r')

# Maven home directory in user cache
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_WRAPPER_CACHE="$MAVEN_USER_HOME/wrapper"

# Derive the distribution directory name from the URL
DIST_FILENAME=$(basename "$DISTRIBUTION_URL")
DIST_NAME="${DIST_FILENAME%-bin.zip}"
MAVEN_HOME="$MAVEN_WRAPPER_CACHE/dists/$DIST_NAME/bin/.."

if [ ! -d "$MAVEN_WRAPPER_CACHE/dists/$DIST_NAME" ]; then
  echo "Downloading Maven: $DISTRIBUTION_URL"
  mkdir -p "$MAVEN_WRAPPER_CACHE/dists"
  TMP_ZIP="$MAVEN_WRAPPER_CACHE/dists/$DIST_FILENAME"
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$TMP_ZIP" "$DISTRIBUTION_URL"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$TMP_ZIP" "$DISTRIBUTION_URL"
  else
    echo "ERROR: Neither curl nor wget found. Please install Maven manually." >&2
    exit 1
  fi
  unzip -q "$TMP_ZIP" -d "$MAVEN_WRAPPER_CACHE/dists/"
  rm -f "$TMP_ZIP"
  echo "Maven downloaded successfully."
fi

# Find the actual maven home (the unzipped folder)
MAVEN_HOME=$(find "$MAVEN_WRAPPER_CACHE/dists" -maxdepth 1 -name "${DIST_NAME}" -type d 2>/dev/null | head -1)
if [ -z "$MAVEN_HOME" ]; then
  # Try without exact match
  MAVEN_HOME=$(find "$MAVEN_WRAPPER_CACHE/dists" -maxdepth 1 -type d -name "apache-maven-*" | head -1)
fi

MAVEN_CMD="$MAVEN_HOME/bin/mvn"

if [ ! -f "$MAVEN_CMD" ]; then
  echo "ERROR: Could not find mvn in $MAVEN_HOME/bin" >&2
  exit 1
fi

exec "$MAVEN_CMD" "$@"
